# ----------------------------------------------------------------------------
# Template only. Copy to .env and change values. Never commit .env.
# You may add variables, but keep every one listed here.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_DB=dakota_python
POSTGRES_USER=dakota
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Mock Source API (Stage 1)
# ----------------------------------------------------------------------------
API_PORT=8000
API_SEED=20261001
API_CLIENT_ID=dakota-ingestion
API_CLIENT_SECRET=change_me
TOKEN_TTL_SECONDS=300            # reviewers will lower this to force mid-run expiry
API_ERROR_RATE=0.05              # fraction of requests returning 500/503
API_RATE_LIMIT_PER_MINUTE=120    # beyond this the API returns 429 + Retry-After
API_RESTATEMENT_RATE=0.02        # fraction of past records restated per /admin/advance-day

# ----------------------------------------------------------------------------
# Ingestion (Stage 2)
# ----------------------------------------------------------------------------
SOURCE_API_URL=http://api:8000
INGEST_PAGE_SIZE=100
INGEST_MAX_RETRIES=5
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Writeback App (Stage 3)
# ----------------------------------------------------------------------------
APP_PORT=8501

# ----------------------------------------------------------------------------
# Reconciliation (Stage 4)
# ----------------------------------------------------------------------------
RECON_HIGH_IMPACT_PCT=20         # edits above this % delta are flagged as high impact
RECON_STALE_DAYS=14              # open overrides older than this are flagged as stale
